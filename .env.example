# TradeCall Frontend Environment Variables

# Backend API URL:
# - Leave empty to use Vite dev proxy (default: requests to /api and /uploads are proxied to http://127.0.0.1:8000)
# - Or specify the full backend base URL (e.g. http://127.0.0.1:8000) for direct connections or production builds
VITE_API_URL=

# Application Name
VITE_APP_NAME="TradeCall India"
